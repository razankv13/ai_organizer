# Supabase Edge Functions Environment Variables
# Copy this file to .env for local development (DO NOT commit .env to git)

# Supabase Configuration
# These are automatically provided by Supabase in production
# For local development, get these from your Supabase project settings

# Your Supabase project URL
# Example: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=your_supabase_url_here

# Supabase service role key (has admin privileges, bypass RLS)
# IMPORTANT: Keep this secret! Never expose in client-side code
# Find in: Project Settings > API > service_role key (secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google Gemini API Key (required for ocr-process and ai-tag functions)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: For local testing
# SUPABASE_ANON_KEY=your_anon_key_here
